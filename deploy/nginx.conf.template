server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

    # Where the local vault lives (docs/kluis.md), for the link in the menu.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control no-cache;
        return 200 '{"kluis_url": "${KLUIS_URL}"}';
    }

    # Same origin as the API: the browser sends the admin token only to this host.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Invitation tokens and admin tokens must not end up in logs.
        access_log off;
    }

    # Firmware mirror (volume written by the firmware-mirror service). Same origin, so the flash station can fetch and
    # check the images without CORS. No fallback to index.html: a missing file is a 404.
    location /firmware/ {
        try_files $uri =404;
        expires -1;
    }

    # "Nu ophalen" in the flash station: ask the firmware mirror for a run now (mirror/mirror.py, MIRROR_TRIGGER).
    # Only with an admin token the API accepts: nginx first asks the API (auth_request). Through a variable plus
    # Docker's resolver, so the Cockpit still starts when the mirror is not there (then this gives a 502).
    location = /firmware-mirror/refresh {
        limit_except POST { deny all; }
        auth_request /_admin_check;
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $mirror_upstream ${MIRROR_UPSTREAM};
        proxy_pass $mirror_upstream/refresh;
        proxy_set_header Authorization "";
        access_log off;
    }

    # Token check for the route above: 2xx from the API = valid admin token, 401/403 = refused.
    location = /_admin_check {
        internal;
        proxy_method GET;
        proxy_pass ${API_UPSTREAM}/admin/overview;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        access_log off;
    }

    # No add_header in locations: that would drop the security headers above (nginx does not merge them).
    location /assets/ {
        expires 1y;
    }

    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
